NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web server / database administration only. Local generation does not use these.
# For Prisma Studio against production, use bun run db:tunnel and port 54329.
DATABASE_URL=
DIRECT_URL=

# Persistent Coolify volume, required only on the web server.
TRANSCRIPT_STORAGE_DIR=/data/transcripts

# Shared by local generation, daily jobs, and the web server.
# Authenticates generation claims/results, transcript uploads, and cache invalidation.
# Generation needs only these two variables and your local OpenCode credentials.
CACHE_REVALIDATION_URL=https://nudge.zaydkrunz.com
CACHE_REVALIDATION_SECRET=

DISCORD_WEBHOOK_URL=
VERIFY_PASSWORD=

# Optional overrides for administrative database access (not generation).
NUDGE_SSH_HOST=zayd@pickleballs
NUDGE_DATABASE_CONTAINER=apiijmbdlkucfbp3nw7mybuv
NUDGE_DATABASE_LOCAL_PORT=54329
